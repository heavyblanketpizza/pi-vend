# Copy to .env and fill in. Both the Django backend and the agent read this file.

# --- Django --------------------------------------------------------------------
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is off: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://pivend.example.com
# Defaults to SQLite in backend/db.sqlite3
# DATABASE_URL=postgres://pivend:pivend@localhost:5432/pivend
# Base URL used in links the agent shares (draft pages, rendered images)
PUBLIC_BASE_URL=http://localhost:8000

# --- Agent <-> Django ------------------------------------------------------------
AGENT_URL=http://localhost:3001
BACKEND_URL=http://localhost:8000
# Shared secret for the internal API (required in production)
AGENT_INTERNAL_TOKEN=dev-internal-token

# --- LLM (pick one provider) ----------------------------------------------------
# anthropic | openai | google | llamacpp | openai-compatible
LLM_PROVIDER=anthropic
# Optional. Defaults: anthropic=claude-opus-5, openai=gpt-5.5, google=gemini-3.5-flash,
# llamacpp=whatever llama-server reports at /v1/models
# LLM_MODEL=
# off | minimal | low | medium | high  (default: medium for cloud, off for local)
# LLM_THINKING=medium

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Local llama.cpp (llama-server must run with --jinja for tool calling):
# LLM_PROVIDER=llamacpp
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_CONTEXT_WINDOW=32768
# LLM_MAX_TOKENS=8192
# Qwen3-style thinking models: enable reasoning and tell pi how to toggle it
# LLM_REASONING=true
# LLM_THINKING_FORMAT=qwen-chat-template
# LLM_VISION=false

# Other OpenAI-compatible servers (vLLM, LM Studio, Ollama, ...):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=

# --- Naver APIs ---------------------------------------------------------------------
# 검색광고 API (keyword volume): searchad.naver.com > 도구 > API 사용 관리
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=
# Naver Developers app with 검색 + 데이터랩(검색어트렌드, 쇼핑인사이트): developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Hours before cached API results are refetched
RESEARCH_CACHE_HOURS=24

# --- Detail page rendering -----------------------------------------------------------
# Leave empty to use the browser installed by `playwright install chromium`
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
DETAIL_PAGE_SLICE_HEIGHT=3000
