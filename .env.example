# Copy to .env and fill in. Both the Django backend and the agent read this file.

# --- Django --------------------------------------------------------------------
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is off: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://pivend.example.com
# Defaults to SQLite in backend/db.sqlite3
# DATABASE_URL=postgres://pivend:pivend@localhost:5432/pivend
# Base URL used in links the agent shares (draft pages, rendered images)
PUBLIC_BASE_URL=http://localhost:8000

# --- Agent <-> Django ------------------------------------------------------------
AGENT_URL=http://localhost:3001
BACKEND_URL=http://localhost:8000
# Shared secret for the internal API (required in production)
AGENT_INTERNAL_TOKEN=dev-internal-token

# --- Accounts -----------------------------------------------------------------------
# Each user signs up and connects their own AI model and Naver API keys in
# 설정 > API 연결. Nothing here is shared between users.
SIGNUPS_OPEN=1
# New accounts confirm their email address before logging in.
EMAIL_VERIFICATION=1
# Mail for verification and password reset. Default prints to the console.
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
# DEFAULT_FROM_EMAIL=Pi-Vend <no-reply@example.com>

# Encrypts users' stored API keys. Required when DJANGO_DEBUG is off. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put the new key first, run `manage.py rotate_credentials`, then drop the old one.
CREDENTIAL_ENCRYPTION_KEYS=

# Users may connect their own LLM server (llama.cpp, vLLM...). Private/internal
# addresses are refused unless this is on: only for single-tenant self-hosting,
# e.g. LLM URL http://llamacpp:8080/v1 in docker compose. Read by Django and the agent.
ALLOW_PRIVATE_LLM_URLS=0

# Shared cache for per-user rate limits across processes (default: in-process memory).
# CACHE_URL=redis://localhost:6379/0    or    dbcache://pivend_cache
# RATE_LIMIT_CHAT_PER_HOUR=60
# RATE_LIMIT_RESEARCH_PER_HOUR=120
# Set if a reverse proxy you control sets X-Forwarded-For.
# TRUST_X_FORWARDED_FOR=0

# Hours before cached Naver API results are refetched (cached per user)
RESEARCH_CACHE_HOURS=24

# --- Detail page rendering -----------------------------------------------------------
# Leave empty to use the browser installed by `playwright install chromium`
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
DETAIL_PAGE_SLICE_HEIGHT=3000
